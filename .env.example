# Application
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/woocommerce_price_bot
DATABASE_POOL_MAX=10

# Redis
REDIS_URL=redis://localhost:6379

# WooCommerce (never commit real credentials)
WOOCOMMERCE_URL=https://your-store.example.com
WOOCOMMERCE_CONSUMER_KEY=ck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WOOCOMMERCE_CONSUMER_SECRET=cs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WOOCOMMERCE_TIMEOUT_MS=5000
WOOCOMMERCE_RETRIES=3
WOOCOMMERCE_PAGE_SIZE=50

# Telegram
TELEGRAM_BOT_TOKEN=000000000:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Price sync
PRICE_SYNC_INTERVAL_MS=60000
PRICE_SYNC_LOCK_TTL_SECONDS=55

# Currency
PRICE_CURRENCY=IRR
PRICE_CURRENCY_LABEL=تومان

# API security
API_KEY=
CORS_ORIGIN=*
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# Monitoring
WORKER_STALE_THRESHOLD_MS=180000
